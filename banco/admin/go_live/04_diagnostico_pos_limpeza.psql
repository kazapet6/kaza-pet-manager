\set ON_ERROR_STOP on
-- Somente leitura de tabelas permanentes. Escritas abaixo são apenas temporárias.
begin transaction isolation level repeatable read read only;
\ir 00_manifesto.psql

create temp table go_live_validacoes (
  secao text not null,
  objeto text not null,
  esperado text not null,
  encontrado text not null,
  ok boolean not null
) on commit drop;

create temp table go_live_assinaturas_preservadas (
  tabela text primary key,
  total bigint not null,
  assinatura text not null
) on commit drop;

do $$
declare
  t record;
  atual bigint;
  assinatura_atual text;
begin
  for t in select nome from go_live_tabelas where acao <> 'preservar' order by nome loop
    execute format('select count(*) from public.%I', t.nome) into atual;
    insert into go_live_validacoes
    values ('operacional_zero', t.nome, '0', atual::text, atual = 0);
  end loop;

  for t in select nome from go_live_tabelas where acao = 'preservar' order by nome loop
    execute format(
      'select count(*), md5(coalesce(jsonb_agg(to_jsonb(x) order by to_jsonb(x)::text), ''[]''::jsonb)::text) from public.%I x',
      t.nome
    ) into atual, assinatura_atual;
    insert into go_live_assinaturas_preservadas values (t.nome, atual, assinatura_atual);
  end loop;
end;
$$;

insert into go_live_validacoes values
('staging', 'importacao_lotes', '1',
 (select count(*)::text from public.importacao_lotes),
 (select count(*) = 1 from public.importacao_lotes)),

select secao, objeto, esperado, encontrado, ok
from go_live_validacoes
order by ok, secao, objeto;

select count(*) as verificacoes,
       count(*) filter (where ok) as aprovadas,
       count(*) filter (where not ok) as falhas
from go_live_validacoes;

-- Comparar com assinaturas_preservadas.csv gerado no backup pré-limpeza.
select tabela, total, assinatura
from go_live_assinaturas_preservadas
order by tabela;

rollback;

-- DESTRUTIVO quando executado manualmente com a confirmação abaixo.
-- NÃO é migration. Não foi executado durante esta preparação.
-- Requer psql, janela de manutenção e backup restaurado em ambiente isolado.
\set ON_ERROR_STOP on
\if :{?backup_validado}
\else
  \echo 'Falta -v backup_validado=SIM_APAGAR_TESTES; limpeza proibida.'
  \quit 3
\endif

begin;
set local lock_timeout = '10s';
set local statement_timeout = '120s';
set local row_security = off;
select set_config('kaza_go_live.confirmacao', :'backup_validado', true);
\ir 00_manifesto.psql

create temp table go_live_preservacao (
  nome text primary key,
  quantidade bigint not null,
  conteudo jsonb not null
) on commit drop;

do $$
declare
  t record;
  nomes text;
  atual bigint;
  dados jsonb;
begin
  if current_setting('kaza_go_live.confirmacao') <> 'SIM_APAGAR_TESTES' then
    raise exception 'Confirmação explícita e backup validado obrigatórios';
  end if;

  -- Inventário fechado: qualquer tabela pública nova/ausente interrompe a operação.
  if exists (
    (select c.relname
       from pg_catalog.pg_class c
       join pg_catalog.pg_namespace n on n.oid = c.relnamespace
      where n.nspname = 'public' and c.relkind in ('r', 'p'))
    except
    (select nome from go_live_tabelas)
  ) or exists (
    (select nome from go_live_tabelas)
    except
    (select c.relname
       from pg_catalog.pg_class c
       join pg_catalog.pg_namespace n on n.oid = c.relnamespace
      where n.nspname = 'public' and c.relkind in ('r', 'p'))
  ) then
    raise exception 'Inventário public divergiu do manifesto 001-039';
  end if;

  select string_agg(format('public.%I', nome), ', ' order by nome)
    into nomes
    from go_live_tabelas;
  execute 'lock table ' || nomes || ' in access exclusive mode';

  -- O lote real precisa continuar íntegro e nunca ter sido promovido.
  if (select count(*) from public.importacao_lotes) <>
       (select valor from go_live_expectativas where chave = 'lotes')
    or (select count(*) from public.importacao_clientes_staging) <>
       (select valor from go_live_expectativas where chave = 'clientes_staging')
    or (select count(*) from public.importacao_clientes_staging where decisao_operador = 'importar') <>
       (select valor from go_live_expectativas where chave = 'clientes_importar')
    or (select count(*) from public.importacao_clientes_staging where decisao_operador = 'ignorar') <>
       (select valor from go_live_expectativas where chave = 'clientes_ignorar')
    or (select count(*) from public.importacao_pets_staging) <>
       (select valor from go_live_expectativas where chave = 'pets_staging')
    or (select count(*) from public.importacao_pets_staging where decisao_operador = 'importar') <>
       (select valor from go_live_expectativas where chave = 'pets_importar')
    or (select count(*) from public.importacao_pets_staging where decisao_operador = 'ignorar') <>
       (select valor from go_live_expectativas where chave = 'pets_ignorar')
    or (select count(*) from public.importacao_mapeamentos) <>
       (select valor from go_live_expectativas where chave = 'mapeamentos') then
    raise exception 'Contagens/decisões do staging divergiram; limpeza proibida';
  end if;

  if exists (
      select 1 from public.importacao_clientes_staging
       where cliente_id_criado is not null or status_validacao = 'ja_importado'
    ) or exists (
      select 1 from public.importacao_pets_staging
       where cliente_id_resolvido is not null
          or pet_id_criado is not null
          or status_validacao = 'ja_importado'
    ) or exists (
      select 1 from public.importacao_lotes
       where completed_at is not null or status = 'concluido'
    ) then
    raise exception 'Há sinal de promoção no staging; limpeza proibida';
  end if;

  -- Guardar uma cópia exata, temporária e transacional de tudo que deve sobreviver.
  for t in select nome from go_live_tabelas where acao = 'preservar' order by nome loop
    execute format(
      'select count(*), coalesce(jsonb_agg(to_jsonb(x) order by to_jsonb(x)::text), ''[]''::jsonb) from public.%I x',
      t.nome
    ) into atual, dados;
    insert into go_live_preservacao(nome, quantidade, conteudo)
    values (t.nome, atual, dados);
  end loop;

  -- Não ampliar a limpeza por herança/particionamento nem por trigger de TRUNCATE.
  if exists (
    select 1
      from pg_catalog.pg_inherits i
      join go_live_tabelas t
        on i.inhrelid = format('public.%I', t.nome)::regclass
        or i.inhparent = format('public.%I', t.nome)::regclass
     where t.acao <> 'preservar'
  ) then
    raise exception 'Herança/particionamento exige nova auditoria';
  end if;

  if exists (
    select 1
      from pg_catalog.pg_trigger g
      join go_live_tabelas t
        on g.tgrelid = format('public.%I', t.nome)::regclass
     where t.acao = 'truncar'
       and not g.tgisinternal
       and (g.tgtype::integer & 32) > 0
  ) then
    raise exception 'Trigger de TRUNCATE não auditado';
  end if;

  if exists (
    select 1
      from pg_catalog.pg_trigger g
      join go_live_tabelas t
        on g.tgrelid = format('public.%I', t.nome)::regclass
     where t.acao = 'apagar'
       and not g.tgisinternal
       and (g.tgtype::integer & 8) > 0
  ) then
    raise exception 'Trigger de DELETE em clientes/pets exige nova auditoria';
  end if;

  -- RESTRICT só é válido se nenhuma tabela preservada referenciar um alvo truncado.
  if exists (
    select 1
      from pg_catalog.pg_constraint k
      join go_live_tabelas alvo
        on k.confrelid = format('public.%I', alvo.nome)::regclass
       and alvo.acao = 'truncar'
     where k.contype = 'f'
       and not exists (
         select 1
           from go_live_tabelas origem
          where origem.acao = 'truncar'
            and k.conrelid = format('public.%I', origem.nome)::regclass
       )
  ) then
    raise exception 'FK de tabela não truncada aponta para alvo operacional';
  end if;

  -- As únicas FKs preservadas aceitas para clientes/pets são as quatro
  -- referências opcionais criadas pela infraestrutura de importação.
  if exists (
    select 1
      from pg_catalog.pg_constraint k
      join go_live_tabelas alvo
        on k.confrelid = format('public.%I', alvo.nome)::regclass
       and alvo.acao = 'apagar'
     where k.contype = 'f'
       and k.conrelid not in (
         'public.importacao_clientes_staging'::regclass,
         'public.importacao_pets_staging'::regclass,
         'public.importacao_mapeamentos'::regclass
       )
       and not exists (
         select 1
           from go_live_tabelas origem
          where origem.acao <> 'preservar'
            and k.conrelid = format('public.%I', origem.nome)::regclass
       )
  ) then
    raise exception 'Nova FK preservada para clientes/pets exige auditoria específica';
  end if;

  select string_agg(format('public.%I', nome), ', ' order by nome)
    into nomes
    from go_live_tabelas
   where acao = 'truncar';

  -- Sem CASCADE e sem reiniciar IDs implicitamente.
  execute 'truncate table ' || nomes || ' continue identity restrict';

  -- Desde a 036, staging possui FKs opcionais para clientes/pets. Por isso estes
  -- dois cadastros são apagados explicitamente, após provar ausência de promoção.
  delete from public.pets;
  delete from public.clientes;

  for t in select nome from go_live_tabelas where acao <> 'preservar' order by nome loop
    execute format('select count(*) from public.%I', t.nome) into atual;
    if atual <> 0 then
      raise exception 'Tabela operacional não ficou vazia: %', t.nome;
    end if;
  end loop;

  -- Reset condicional: nunca altera sequência enquanto houver cadastro remanescente.
  if not exists (select 1 from public.clientes) then
    if to_regclass('public.clientes_codigo_seq') is null
       or pg_get_serial_sequence('public.clientes', 'id') is distinct from 'public.clientes_codigo_seq' then
      raise exception 'Associação de clientes_codigo_seq divergiu';
    end if;
    alter sequence public.clientes_codigo_seq restart with 1;
  end if;

  if not exists (select 1 from public.pets) then
    if to_regclass('public.pets_codigo_seq') is null
       or pg_get_serial_sequence('public.pets', 'id') is distinct from 'public.pets_codigo_seq' then
      raise exception 'Associação de pets_codigo_seq divergiu';
    end if;
    alter sequence public.pets_codigo_seq restart with 1;
  end if;

  if exists (
    select 1
      from pg_catalog.pg_sequence s
     where s.seqrelid in (
       'public.clientes_codigo_seq'::regclass,
       'public.pets_codigo_seq'::regclass
     )
       and (s.seqincrement <> 1 or s.seqmin <> 1 or s.seqcache <> 1 or s.seqcycle)
  ) then
    raise exception 'Configuração de sequência divergente';
  end if;

  -- Comparação integral, inclusive original/resolvido/avisos/decisões do staging.
  for t in select * from go_live_preservacao order by nome loop
    execute format(
      'select count(*), coalesce(jsonb_agg(to_jsonb(x) order by to_jsonb(x)::text), ''[]''::jsonb) from public.%I x',
      t.nome
    ) into atual, dados;
    if atual is distinct from t.quantidade or dados is distinct from t.conteudo then
      raise exception 'Tabela preservada foi alterada: %', t.nome;
    end if;
  end loop;
end;
$$;

commit;

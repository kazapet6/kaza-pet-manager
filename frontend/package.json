{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:motor": "node --experimental-strip-types src/motorDisponibilidade/testes.ts",
    "test:fase-g": "node --experimental-strip-types src/confirmacao/testesFaseG.ts",
    "test:fase-h": "node --experimental-strip-types src/confirmacao/testesFaseH.ts",
    "test:agenda": "node --experimental-strip-types src/data/testesAgendaDiaria.ts",
    "test:pets": "node --experimental-strip-types src/data/testesPetsIncompletos.ts && node --experimental-strip-types src/data/testesSubmissaoPet.ts",
    "test:acoes-rapidas": "node --experimental-strip-types src/agenda/testesAcoesRapidas.ts",
    "test:novo-agendamento": "node --experimental-strip-types src/agenda/testesNovoAgendamento.ts",
    "test:status-atendimento": "node --experimental-strip-types src/statusAtendimento/testes.ts",
    "test:remarcacao": "node --experimental-strip-types src/remarcacao/testes.ts",
    "test:observacoes": "node --experimental-strip-types src/observacoesAtendimento/testes.ts",
    "test:conclusao": "node --experimental-strip-types src/conclusaoAtendimento/testes.ts",
    "test:pacotes": "node --experimental-strip-types src/pacotes/testes.ts",
    "test:contratos": "node --experimental-strip-types src/contratos/testes.ts",
    "test:materializacao": "node --experimental-strip-types src/contratos/testesMaterializacao.ts",
    "test:creditos": "node --experimental-strip-types src/contratos/testesCreditos.ts",
    "test:cors": "node --experimental-strip-types src/cors/testes.ts",
    "test:importacao": "node --experimental-strip-types src/importacao/testes.ts && node --experimental-strip-types src/importacao/testesStaging.ts && node --experimental-strip-types src/importacao/testesGrupos.ts && node --experimental-strip-types src/importacao/testesSugestoesRacas.ts",
    "preview": "vite preview",
    "test:whatsapp-hml": "node --experimental-strip-types src/whatsappHml/testes.ts",
    "test:mensageria": "node --experimental-strip-types src/mensageria/testes.ts && npm run test:confirmacao-whatsapp-hml && npm run test:retornos-whatsapp-hml && npm run test:api-confirmacao-hml && npm run test:template-confirmacao-hml && npm run test:template-aprovacao-meta && npm run test:orquestrador-convite-hml && npm run test:resposta-outbox-hml && npm run test:orquestrador-resposta-hml && npm run test:publicacao-modelo-hml",
    "test:confirmacao-whatsapp-hml": "node --experimental-strip-types src/mensageria/testesConfirmacaoWhatsapp.ts",
    "test:retornos-whatsapp-hml": "node --experimental-strip-types src/mensageria/testesRespostaAoCliqueWhatsapp.ts",
    "test:api-confirmacao-hml": "node --experimental-strip-types ../supabase/functions/mensageria-confirmacao-hml/testes.ts",
    "test:template-confirmacao-hml": "node --experimental-strip-types ../supabase/functions/mensageria-confirmacao-hml/testesTemplateConfirmacao.ts",
    "test:template-aprovacao-meta": "node --experimental-strip-types ../supabase/functions/mensageria-confirmacao-hml/testesSolicitacaoTemplateMeta.ts",
    "test:orquestrador-convite-hml": "node --experimental-strip-types ../supabase/functions/mensageria-confirmacao-hml/testesOrquestradorConviteHml.ts",
    "test:resposta-outbox-hml": "node --experimental-strip-types ../supabase/functions/mensageria-confirmacao-hml/testesRespostaOutboxHml.ts",
    "test:orquestrador-resposta-hml": "node --experimental-strip-types ../supabase/functions/mensageria-confirmacao-hml/testesOrquestradorRespostaOutboxHml.ts",
    "test:publicacao-modelo-hml": "node --experimental-strip-types ../supabase/functions/mensageria-editor-hml/testesPublicacaoGuard.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
